# Badge secrets file. Copy it to .env at the repository root (gitignored) or to ../.env, or point BADGE_ENV_FILE at it,
# then chmod 600. Only the egress gateway container ever receives the API key; scripts never print it.

# Local demo ("build" profile): any OpenAI-compatible API with structured outputs and an embeddings endpoint.
# Only BUILD_LLM_API_KEY has to be filled for OpenAI; the other values are the tested defaults.
BUILD_LLM_BASE_URL=https://api.openai.com/v1
BUILD_LLM_API_KEY=
BUILD_LLM_MODEL=gpt-6-luna
BUILD_EMBEDDING_MODEL=text-embedding-3-small
BUILD_EMBEDDING_DIMENSIONS=384

# Optional: Phala Confidential AI ("phala" profile) and Phala Cloud deployment of the CVM (docs/DEPLOY.md).
PHALA_AI_BASE_URL=
PHALA_AI_API_KEY=
PHALA_AI_MODEL=
PHALA_CLOUD_API_KEY=
